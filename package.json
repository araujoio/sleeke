{
  "name": "sleeke",
  "version": "1.0.0",
  "description": "",
  "author": "araujoio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/araujoio/sleeke.git"
  },
  "keywords": [
    "sleeke",
    "react",
    "web",
    "front-end",
    "cli",
    "next",
    "vite",
    "server"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "sleeke": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "npm run format && npm run lint && tsup --clean && tsx src/utils/copy-templates.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest"
  },
  "dependencies": {
    "commander": "14.0.3",
    "fs-extra": "11.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "25.5.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
